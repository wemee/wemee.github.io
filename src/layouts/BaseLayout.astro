---
import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import RelatedNotes from '@/components/RelatedNotes.astro';
import SearchPalette from '@/components/SearchPalette.astro';
import Comments from '@/components/comments/Comments.tsx';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  articleAuthor?: string;
  articleTags?: string[];
  /** Current page identifier for nav highlighting (home, math, game, tools, about, blog) */
  currentPage?: string;
  /** 是否顯示留言區。預設開啟;全螢幕遊戲/工具頁可傳 false 關閉。 */
  comments?: boolean;
}

const {
  title,
  description = "挫屎勇的個人網站 - 這裡紀錄開發心得、分享數學工具與網頁遊戲。",
  image = "/images/og-default.png",
  articleDate,
  articleAuthor,
  articleTags = [],
  currentPage,
  comments = true,
} = Astro.props;

/**
 * 品牌識別。Google 的 site name 是「網域層級」推導的，而 wemee.github.io 是
 * github.io 的子網域 —— 訊號不夠明確時它會沿用母站實體（實測會顯示成
 * 「GitHub Pages documentation」）。因此以下三處必須一致且簡短：
 * og:site_name、首頁 WebSite JSON-LD 的 name、首頁 <title> 的品牌詞。
 */
const BRAND = '挫屎勇';
const SAME_AS = [
  'https://github.com/wemee',
  'https://www.threads.net/@wemee7012',
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const avatarURL = new URL('/images/avatar.webp', Astro.site);
const siteURL = Astro.site?.href ?? canonicalURL.origin + '/';
const isArticle = !!articleDate;
const isHome = Astro.url.pathname === '/';

// 全站統一為「頁面名 | 挫屎勇」。首頁與關於我已自帶品牌詞，不重複附加。
const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;

const personNode = {
  "@type": "Person",
  "@id": `${siteURL}#person`,
  "name": BRAND,
  "alternateName": "wemee",
  "url": siteURL,
  "image": avatarURL.href,
  "sameAs": SAME_AS,
};
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${BRAND}的部落格`} href={new URL('/rss.xml', Astro.site)} />

  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle} />
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content={BRAND} />
  {isArticle && articleDate && (
    <meta property="article:published_time" content={articleDate.toISOString()} />
  )}
  {isArticle && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )}
  {isArticle && articleTags.map((tag) => (
    <meta property="article:tag" content={tag} />
  ))}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-L980F1NV6M"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-L980F1NV6M');
  </script>

  <!-- Tailwind CSS is imported via global.css -->

  <!-- KaTeX CSS for math rendering (rendered at build time via rehype-katex) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
  <meta name="google-site-verification" content="R4S40Rh0laFxWlBMFmr6nNqvc2QUowCa-EonPkLfis4" />

  <!-- JSON-LD Structured Data.
       WebSite schema 依 Google 規範「只放首頁」——散佈到全站會讓 site name 訊號
       失效。內頁文章輸出 BlogPosting，其餘內頁不輸出。 -->
  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteURL}#website`,
          "name": BRAND,
          "alternateName": ["wemee", "挫屎勇的個人網站"],
          "url": siteURL,
          "description": description,
          "inLanguage": "zh-Hant",
          "publisher": { "@id": `${siteURL}#person` }
        },
        personNode
      ]
    })} />
  )}
  {isArticle && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": socialImageURL.href,
      "datePublished": articleDate?.toISOString(),
      "inLanguage": "zh-Hant",
      "author": {
        "@type": "Person",
        "name": articleAuthor || BRAND,
        "url": siteURL
      },
      "publisher": personNode,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL.href
      },
      "keywords": articleTags.join(", ")
    })} />
  )}
</head>
<body>
  <Navbar currentPage={currentPage} />
  <!-- data-pagefind-body scopes site search to BaseLayout pages only; the
       display:contents wrapper adds no box so it never affects layout. The
       meta guarantees a clean result title even on pages without an <h1>. -->
  <div data-pagefind-body data-pagefind-meta={`title:${title}`} style="display: contents;">
    <slot />
  </div>
  {comments && <Comments page={Astro.url.pathname} client:visible />}
  <RelatedNotes currentPath={Astro.url.pathname} />
  <Footer />
  <SearchPalette />

</body>
</html>
