---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
    currentPage="game"
    title="彈道對決 - 回合制砲兵對戰"
    description="經典 Scorched Earth 風格的回合制砲兵遊戲《彈道對決》：拖曳拉弓瞄準，或用方向鍵調角度力道、空白鍵發射，算準拋物線越過隨機山脈轟掉 AI 砲台。爆炸傷害隨距離衰減，純 Canvas 打造。"
>
    <main class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 mt-8 mb-14">
        <header class="mb-5">
            <a href="/game" class="inline-block mb-3 text-sm text-accent-green hover:text-accent-green/80 transition">
                ← 返回遊戲列表
            </a>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h1 class="text-3xl font-bold text-base-50">💥 彈道對決</h1>
                <p class="text-base-400 text-sm">回合制砲兵 — 算準角度與力道，越過山頭轟掉對面</p>
            </div>
        </header>

        <!-- 戰報：雙方血量 -->
        <div class="flex items-center gap-3 mb-3">
            <div class="flex-1">
                <div class="flex items-baseline justify-between mb-1">
                    <span class="text-xs font-bold tracking-wider text-accent-blue">你</span>
                    <span id="art-player-hp" class="text-xs font-mono text-base-300">100</span>
                </div>
                <div class="h-2.5 rounded-full bg-base-900 border border-base-600 overflow-hidden">
                    <div id="art-player-bar" class="h-full bg-accent-blue transition-[width] duration-150" style="width:100%"></div>
                </div>
            </div>

            <div class="px-3 py-1.5 rounded-md bg-base-800 border border-base-600 text-center whitespace-nowrap leading-tight">
                <div id="art-stage" class="text-sm font-bold text-accent-yellow">第 1 關</div>
                <div id="art-round" class="text-[10px] font-mono text-base-400">第 1 回合</div>
            </div>

            <div class="flex-1">
                <div class="flex items-baseline justify-between mb-1">
                    <span id="art-enemy-hp" class="text-xs font-mono text-base-300">100</span>
                    <span class="text-xs font-bold tracking-wider text-accent-orange">AI</span>
                </div>
                <div class="h-2.5 rounded-full bg-base-900 border border-base-600 overflow-hidden flex justify-end">
                    <div id="art-enemy-bar" class="h-full bg-accent-orange transition-[width] duration-150" style="width:100%"></div>
                </div>
            </div>
        </div>

        <!-- 戰場 -->
        <div class="relative rounded-2xl border border-base-600 bg-base-900 p-2 shadow-lg shadow-accent-orange/5">
            <canvas id="artilleryCanvas" class="art-canvas"></canvas>

            <div id="art-start" class="art-overlay">
                <h2 class="text-2xl font-bold text-base-50 mb-2">💥 彈道對決</h2>
                <p class="text-base-300 text-sm max-w-md mb-1">
                    輪流開砲。地形每關隨機、沒有風，所以只要算準<strong class="text-base-50">角度</strong>與<strong class="text-base-50">力道</strong>就能命中——但被炸到會被震退，解會慢慢失準。
                </p>
                <p class="text-base-400 text-xs max-w-md mb-4">
                    打倒對面就過關，下一關敵人血更厚、打得更準。輸掉就從第 1 關重來，看你能走多遠。
                </p>
                <p id="art-best" class="text-accent-yellow text-xs mb-4 h-4"></p>
                <button id="art-start-btn" class="px-6 py-3 rounded-lg bg-accent-orange hover:bg-accent-orange/80 text-base-50 font-medium transition">
                    開始對戰
                </button>
            </div>

            <div id="art-over" class="art-overlay hidden">
                <h2 id="art-over-title" class="text-3xl font-bold text-base-50 mb-2">過關</h2>
                <p id="art-over-desc" class="text-base-300 text-sm mb-1"></p>
                <p id="art-over-next" class="text-base-400 text-xs mb-5 h-4"></p>
                <button id="art-again-btn" class="px-6 py-3 rounded-lg bg-accent-green hover:bg-accent-green/80 text-base-900 font-medium transition">
                    下一關
                </button>
            </div>
        </div>

        <!-- 射擊控制台 -->
        <section class="mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto] items-end rounded-xl border border-base-600 bg-base-800 p-4">
            <div class="art-dial">
                <div class="flex items-baseline justify-between">
                    <label for="art-angle" class="art-label">仰角</label>
                    <output id="art-angle-out" class="art-readout text-accent-cyan">45°</output>
                </div>
                <div class="art-stepper">
                    <button type="button" class="art-step" data-target="angle" data-delta="-1" aria-label="仰角減 1 度">−</button>
                    <input id="art-angle" class="art-range" type="range" min="0" max="90" step="1" value="45" />
                    <button type="button" class="art-step" data-target="angle" data-delta="1" aria-label="仰角加 1 度">+</button>
                </div>
            </div>

            <div class="art-dial">
                <div class="flex items-baseline justify-between">
                    <label for="art-power" class="art-label">力道</label>
                    <output id="art-power-out" class="art-readout text-accent-yellow">60%</output>
                </div>
                <div class="art-stepper">
                    <button type="button" class="art-step" data-target="power" data-delta="-1" aria-label="力道減 1">−</button>
                    <input id="art-power" class="art-range art-range-power" type="range" min="0" max="100" step="1" value="60" />
                    <button type="button" class="art-step" data-target="power" data-delta="1" aria-label="力道加 1">+</button>
                </div>
            </div>

            <button id="art-fire" class="h-11 px-7 rounded-lg bg-accent-red hover:bg-accent-red/80 disabled:opacity-35 disabled:cursor-not-allowed text-base-50 font-bold tracking-wide transition">
                發射
            </button>
        </section>

        <p class="mt-3 text-xs text-base-500 leading-relaxed">
            <strong class="text-base-300">三種瞄準方式：</strong>
            在畫面上<strong class="text-base-300">往後拉再放開</strong>（像拉弓，拉越遠力道越大）·
            用<strong class="text-base-300">滑桿或 ± 鈕</strong>精調數值後按發射 ·
            全鍵盤操作：<strong class="text-base-300">↑↓</strong> 調角度、<strong class="text-base-300">←→</strong> 調力道、
            <strong class="text-base-300">空白鍵</strong>發射（按住 Shift 調整幅度加大為 5）·
            開始與過關畫面按 <strong class="text-base-300">Enter</strong> 繼續
        </p>
    </main>
</BaseLayout>

<style>
    .art-canvas {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        /* 拖曳瞄準時不要觸發頁面捲動 */
        touch-action: none;
        cursor: crosshair;
    }

    .art-overlay {
        position: absolute;
        inset: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 24px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-base-900) 88%, transparent);
        backdrop-filter: blur(3px);
    }

    .art-overlay.hidden {
        display: none;
    }

    .art-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-base-400);
    }

    .art-readout {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 20px;
        font-weight: 700;
        line-height: 1;
    }

    .art-stepper {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
    }

    .art-step {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        border: 1px solid var(--color-base-600);
        background: var(--color-base-900);
        color: var(--color-base-100);
        font-size: 19px;
        font-weight: 700;
        line-height: 1;
        touch-action: manipulation;
        transition:
            background 150ms ease,
            border-color 150ms ease,
            transform 100ms ease;
    }

    .art-step:hover:not(:disabled) {
        background: var(--color-base-700);
        border-color: var(--color-accent-cyan);
        color: var(--color-base-50);
    }

    .art-step:active:not(:disabled) {
        transform: translateY(1px);
        background: var(--color-accent-cyan);
        color: var(--color-base-900);
    }

    .art-step:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .art-range {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: var(--color-base-900);
        border: 1px solid var(--color-base-600);
        outline: none;
    }

    .art-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--color-accent-cyan);
        border: 2px solid var(--color-base-50);
        cursor: pointer;
    }

    .art-range::-moz-range-thumb {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--color-accent-cyan);
        border: 2px solid var(--color-base-50);
        cursor: pointer;
    }

    .art-range-power::-webkit-slider-thumb {
        background: var(--color-accent-yellow);
    }

    .art-range-power::-moz-range-thumb {
        background: var(--color-accent-yellow);
    }

    .art-range:focus-visible {
        border-color: var(--color-accent-cyan);
    }
</style>

<script>
    import { ArtilleryGame } from '@/lib/games/artillery/ArtilleryGame';
    import { enemyHpForStage } from '@/lib/games/artillery/stage';
    import type { ArtilleryState, Side } from '@/lib/games/artillery/types';

    const canvas = document.getElementById('artilleryCanvas') as HTMLCanvasElement;
    const angleInput = document.getElementById('art-angle') as HTMLInputElement;
    const powerInput = document.getElementById('art-power') as HTMLInputElement;
    const angleOut = document.getElementById('art-angle-out') as HTMLOutputElement;
    const powerOut = document.getElementById('art-power-out') as HTMLOutputElement;
    const fireBtn = document.getElementById('art-fire') as HTMLButtonElement;
    const roundLabel = document.getElementById('art-round') as HTMLElement;
    const startOverlay = document.getElementById('art-start') as HTMLElement;
    const overOverlay = document.getElementById('art-over') as HTMLElement;
    const overTitle = document.getElementById('art-over-title') as HTMLElement;
    const overDesc = document.getElementById('art-over-desc') as HTMLElement;

    const stepButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.art-step'));
    const stageLabel = document.getElementById('art-stage') as HTMLElement;
    const bestLabel = document.getElementById('art-best') as HTMLElement;
    const overNext = document.getElementById('art-over-next') as HTMLElement;
    const againBtn = document.getElementById('art-again-btn') as HTMLButtonElement;
    const startBtn = document.getElementById('art-start-btn') as HTMLButtonElement;

    const BEST_STAGE_KEY = 'artilleryBestStage';
    const readBestStage = () => Number(localStorage.getItem(BEST_STAGE_KEY) || '0');
    const renderBest = () => {
        const best = readBestStage();
        bestLabel.textContent = best > 0 ? `最遠紀錄：第 ${best} 關` : '';
    };
    renderBest();

    const bars: Record<Side, HTMLElement> = {
        player: document.getElementById('art-player-bar') as HTMLElement,
        enemy: document.getElementById('art-enemy-bar') as HTMLElement,
    };
    const hpLabels: Record<Side, HTMLElement> = {
        player: document.getElementById('art-player-hp') as HTMLElement,
        enemy: document.getElementById('art-enemy-hp') as HTMLElement,
    };

    const game = new ArtilleryGame(canvas, {
        onStateChange: (state: ArtilleryState, display: { hp: Record<Side, number>; stage: number }) => {
            stageLabel.textContent = `第 ${display.stage} 關`;
            roundLabel.textContent = `第 ${state.round} 回合`;
            (['player', 'enemy'] as Side[]).forEach((side) => {
                const hp = Math.max(0, display.hp[side]);
                const maxHp = state.turrets[side].maxHp;
                bars[side].style.width = `${(hp / maxHp) * 100}%`;
                hpLabels[side].textContent = String(Math.round(hp));
            });
        },
        onAimChange: (aim) => {
            angleInput.value = String(Math.round(aim.angle));
            powerInput.value = String(Math.round(aim.power));
            angleOut.textContent = `${Math.round(aim.angle)}°`;
            powerOut.textContent = `${Math.round(aim.power)}%`;
        },
        onPhaseChange: (phase) => {
            // 瞄準值整場都能調（可以趁 AI 出手時先算好下一發），只有開火受回合限制
            const matchLive = phase !== 'over';
            fireBtn.disabled = phase !== 'aiming';
            angleInput.disabled = !matchLive;
            powerInput.disabled = !matchLive;
            stepButtons.forEach((button) => (button.disabled = !matchLive));
        },
        onStageEnd: ({ winner, cleared, stage }) => {
            if (cleared) {
                overTitle.textContent = `🏆 第 ${stage} 關過關`;
                overDesc.textContent = '對面的砲台被你轟成廢鐵了。';
                overNext.textContent = `下一關敵人血量 ${enemyHpForStage(stage + 1)}，而且會打得更準。`;
                againBtn.textContent = `前往第 ${stage + 1} 關`;

                if (stage > readBestStage()) localStorage.setItem(BEST_STAGE_KEY, String(stage));
                againBtn.dataset.cleared = 'true';
            } else {
                overTitle.textContent = winner === 'draw' ? '⚖️ 同歸於盡' : '💀 落敗';
                overDesc.textContent =
                    winner === 'draw'
                        ? `最後一發把兩邊一起送走了。止步於第 ${stage} 關。`
                        : `被 AI 算得更準。止步於第 ${stage} 關。`;
                overNext.textContent = readBestStage() > 0 ? `最遠紀錄：第 ${readBestStage()} 關` : '';
                againBtn.textContent = '從第 1 關重來';
                againBtn.dataset.cleared = 'false';
            }
            renderBest();
            overOverlay.classList.remove('hidden');
        },
    });

    angleInput.addEventListener('input', () => game.setAngle(Number(angleInput.value)));
    powerInput.addEventListener('input', () => game.setPower(Number(powerInput.value)));

    // ±1 微調。以顯示值（整數）為基準，拖曳出來的小數會順勢對齊到整數
    stepButtons.forEach((button) => {
        button.addEventListener('click', () => {
            const delta = Number(button.dataset.delta);
            if (button.dataset.target === 'angle') {
                game.setAngle(Math.round(Number(angleInput.value)) + delta);
            } else {
                game.setPower(Math.round(Number(powerInput.value)) + delta);
            }
            // 交還焦點，否則方向鍵與空白鍵會被按鈕吃掉
            button.blur();
        });
    });
    fireBtn.addEventListener('click', () => {
        game.fire();
        // 交還焦點，否則之後的方向鍵與空白鍵會被按鈕吃掉
        fireBtn.blur();
    });

    startBtn.addEventListener('click', () => {
        startOverlay.classList.add('hidden');
        game.setInputLocked(false);
        // 交還焦點，否則空白鍵會被剛按過的按鈕吃掉
        startBtn.blur();
    });

    /**
     * 遮罩上的按鈕用 Enter 觸發，讓整局都能純鍵盤操作。
     * 這裡刻意不自動把焦點放到按鈕上 —— 按鈕一旦有焦點，空白鍵也會觸發它，
     * 關卡結束瞬間習慣性按空白鍵發射就會誤跳過過關畫面。
     */
    window.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;

        const target = event.target as HTMLElement | null;
        if (target && ['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON'].includes(target.tagName)) return;

        const overlayButton = !startOverlay.classList.contains('hidden')
            ? startBtn
            : !overOverlay.classList.contains('hidden')
              ? againBtn
              : null;

        if (!overlayButton) return;
        event.preventDefault();
        overlayButton.click();
    });

    againBtn.addEventListener('click', () => {
        overOverlay.classList.add('hidden');
        if (againBtn.dataset.cleared === 'true') {
            game.nextStage();
        } else {
            game.startRun();
        }
        game.setInputLocked(false);
        againBtn.blur();
    });
</script>
