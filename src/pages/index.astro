---
import BaseLayout from '@/layouts/BaseLayout.astro';

const sections = [
  {
    icon: '🧮',
    title: '數學工具',
    description: '提供互動式的數學視覺化工具，將抽象的公式概念具象化，助您直觀理解。',
    href: '/math/'
  },
  {
    icon: '🧪',
    title: '程式實驗室',
    description: '動手學程式。每堂課都附一個可在 Google Colab 直接執行的 notebook——看得到、改得動、跑得起來。從 Python 資料視覺化、機器學習，到從零打造一個迷你 GPT。',
    href: '/lab/'
  },
  {
    icon: '🎮',
    title: '遊戲',
    description: '收錄經典重製與趣味的網頁小遊戲，無需下載安裝，打開瀏覽器即可輕鬆遊玩。',
    href: '/game/'
  },
  {
    icon: '🛠️',
    title: '工具',
    description: '解決生活小麻煩的線上工具：圖片壓縮、QR Code、證件照製作，全部純瀏覽器處理，不上傳資料。',
    href: '/tools/'
  }
];
---
<BaseLayout currentPage="home"
  title="挫屎勇 | 數學工具・網頁遊戲・程式實驗室・AI 開發日誌"
  description="挫屎勇 (wemee) 的個人網站。免費的互動式數學視覺化工具、可在 Colab 直接執行的程式實驗室課程、Canvas 與 Phaser 網頁小遊戲，以及 AI Agent 開發日誌。全部工具皆在瀏覽器運行，不上傳任何資料。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <h1 class="text-3xl font-bold text-base-50 mb-3">挫屎勇的個人網站</h1>
    <p class="text-base-400 mb-2 max-w-3xl leading-relaxed">
      我是<strong class="text-base-200 font-semibold">挫屎勇</strong>(英文 ID <strong class="text-base-200 font-semibold">wemee</strong>)，
      一個喜歡把抽象概念做成「看得到、摸得到」的東西的開發者。
    </p>
    <p class="text-base-400 mb-8 max-w-3xl leading-relaxed">
      這裡放的是我自己動手做的互動式數學視覺化、可以直接在 Google Colab 跑起來的程式課程、
      用 Canvas 與 Phaser 寫的網頁小遊戲，還有一系列跟 AI Agent 一起寫程式的開發日誌。
      所有線上工具都在你的瀏覽器裡運算，不會上傳任何資料。
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sections.map((section) => (
        <div class="flex flex-col rounded-lg border border-base-600 bg-base-800 h-full">
          <div class="p-5 flex-1">
            <h5 class="text-lg font-semibold text-base-50 mb-2">{section.icon} {section.title}</h5>
            <p class="text-base-400">{section.description}</p>
          </div>
          <div class="px-5 pb-5">
            <a href={section.href} class="inline-block px-4 py-2 rounded bg-accent-blue hover:bg-accent-blue/80 text-base-50 font-medium transition">
              前往
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

